# Google Sheets API (legacy - for backward compatibility)
VITE_SHEET_ID=your-sheet-id-here

# Backend API URL (optional - defaults to same domain for Cloudflare Pages)
# VITE_API_URL=https://your-domain.pages.dev

# For local development with Cloudflare Pages Functions
# VITE_API_URL=http://localhost:8788

# MongoDB Atlas Configuration (Set these in Cloudflare Pages dashboard)
# MONGODB_APP_ID=your-app-service-id
# MONGODB_API_KEY=your-api-key